# Sending domain — becomes MAILGUN_DOMAIN in the proxy's .env (required)
SES_DOMAIN=example.com

# Optional: region for the stack and all resources (default: us-east-1)
# AWS_REGION=us-east-1

# Optional: explicit AWS account id (default: resolved from your CLI credentials).
# Only needed for synth/deploy when HOSTED_ZONE_NAME is set.
# AWS_ACCOUNT_ID=123456789012

# Optional: Route53 public hosted zone containing SES_DOMAIN (default: unset).
# When set, the DKIM (and MAIL FROM) DNS records are created automatically.
# HOSTED_ZONE_NAME=example.com

# Optional: CloudFormation stack name (default: GhostSesProxy).
# All resource-name defaults derive from it, so changing it alone yields a
# collision-free second deployment.
# STACK_NAME=GhostSesProxy

# Optional: SES Configuration Set name  (default: <stack-prefix>, e.g. ghost-ses-proxy)
# SES_CONFIGURATION_SET=ghost-ses-proxy

# Optional: SNS topic name  (default: <stack-prefix>-events, e.g. ghost-ses-proxy-events)
# SNS_TOPIC_NAME=ghost-ses-proxy-events

# Optional: SQS queue name; the DLQ is <name>-dlq
# (default: <stack-prefix>-events, e.g. ghost-ses-proxy-events)
# SQS_QUEUE_NAME=ghost-ses-proxy-events

# Optional: IAM user name  (default: <stack-prefix>, e.g. ghost-ses-proxy)
# IAM_USER_NAME=ghost-ses-proxy

# Optional: Secrets Manager secret name holding the proxy's access key
# (default: <stack-prefix>/credentials, e.g. ghost-ses-proxy/credentials)
# CREDENTIALS_SECRET_NAME=ghost-ses-proxy/credentials

# Optional: increment to rotate the IAM access key on the next deploy (default: 1)
# ACCESS_KEY_SERIAL=1

# Optional: SQS message retention in days, max 14 (default: 14)
# SQS_RETENTION_DAYS=14

# Optional: SQS visibility timeout in seconds (default: 30)
# SQS_VISIBILITY_TIMEOUT_SECONDS=30

# Optional: receives before a message moves to the DLQ; 0 disables the DLQ (default: 5)
# DLQ_MAX_RECEIVE_COUNT=5

# Optional: custom MAIL FROM subdomain, e.g. bounce -> bounce.<SES_DOMAIN> (default: unset)
# SES_MAIL_FROM_SUBDOMAIN=bounce
