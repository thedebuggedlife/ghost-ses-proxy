{
  "name": "ghost-ses-proxy",
  "version": "1.0.0",
  "description": "Send Ghost newsletter emails through AWS SES instead of Mailgun — drop-in Mailgun API proxy",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephsellers/ghost-ses-proxy.git"
  },
  "keywords": [
    "ghost",
    "ses",
    "aws",
    "mailgun",
    "proxy",
    "newsletter",
    "email"
  ],
  "author": "Joseph Sellers",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/josephsellers/ghost-ses-proxy/issues"
  },
  "homepage": "https://github.com/josephsellers/ghost-ses-proxy#readme",
  "dependencies": {
    "@aws-sdk/client-ses": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "better-sqlite3": "^11.0.0",
    "busboy": "^1.6.0",
    "express": "^4.21.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "aws-sdk-client-mock": "^4.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
